QPushButton#createNoteButton { background-color: #3678b5; color: white; border-radius: 6px; padding: 10px; font-weight: bold; }
QPushButton#createNoteButton:hover { background-color: #285e91; }
QPushButton#cancelButton { background-color: #e2e8f0; color: #17365d; border-radius: 6px; padding: 10px; font-weight: bold; }
QPushButton#cancelButton:hover { background-color: #cbd5e1; }
QLabel#statusLabel { font-size: 12px; }</string>
